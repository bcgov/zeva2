{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Presets from https://github.com/bcgov/renovate-config",
  "extends": [
    "github>bcgov/renovate-config#2026.10.29"
  ],
  "constraints": {
    "npm": "<13"
  },
  "packageRules": [
      {
        "description": ["Pin semantic-release to v25 until v26 artifact/EALLOWREMOTE issue is resolved"],
        "matchPackageNames": ["semantic-release"],
        "allowedVersions": "<26.0.0"
      },
      {
        "description": ["Match local docker-compose Redis version to production 8.2.2"],
        "matchDatasources": ["docker"],
        "matchPackageNames": ["redis"],
        "allowedVersions": "8.2.2"
      },
      {
        "description": ["Pin postgres docker tag to production 17.7"],
        "matchDatasources": ["docker"],
        "matchPackageNames": ["postgres"],
        "allowedVersions": "17.7"
      }            
    ]   
}
