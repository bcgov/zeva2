FROM docker.io/library/node:26.13.1

WORKDIR /next

COPY . .

RUN npm ci

RUN npm run generate-prisma-client

RUN mkdir -p /tmp/.npm \
  && chgrp -R 0 /tmp/.npm \
  && chmod 770 /tmp/.npm \
  && chmod 1777 /tmp

ENV HOME=/tmp \
    NPM_CONFIG_CACHE=/tmp/.npm

USER 1001:0

CMD ["/bin/sh", "-c", "\
 for cfg in database redis email; do \
 if [ -f /vault/secrets/$cfg ]; then \
 . /vault/secrets/$cfg; \
 fi; \
 done; \
 npm run bullmq\
"]
