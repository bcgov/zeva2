FROM docker.io/library/node:26.13.1 AS base

WORKDIR /next

FROM base AS dependencies

COPY package.json package-lock.json ./

RUN npm ci

FROM base AS builder

COPY --from=dependencies /next/node_modules ./node_modules
COPY . .

ARG ZEVA2_VERSION
ENV ZEVA2_VERSION=$ZEVA2_VERSION

RUN npm run generate-prisma-client && npm run generate-old-prisma-client
RUN npm run build
RUN mkdir -p public

FROM base AS runner

ENV NODE_ENV=production \
    HOME=/tmp \
    NPM_CONFIG_CACHE=/tmp/.npm

COPY package.json package-lock.json ./

RUN mkdir -p /tmp/.npm \
  && npm ci --omit=dev \
  && npm cache clean --force

COPY --from=builder /next/.next ./.next
COPY --from=builder /next/public ./public
COPY --from=builder /next/next.config.ts ./next.config.ts
COPY --from=builder /next/prisma ./prisma
COPY --from=builder /next/prismaOld ./prismaOld

ARG ZEVA2_VERSION
ENV ZEVA2_VERSION=$ZEVA2_VERSION

RUN mkdir -p /next/.next/cache \
  && chgrp -R 0 /next/.next /tmp/.npm \
  && chmod -R g=u /next/.next \
  && chmod 770 /tmp/.npm

USER 1001:0

EXPOSE 3000

CMD ["/bin/sh", "-c", "\
  for cfg in database s3 redis cthub auth; do \
    if [ -f /vault/secrets/$cfg ]; then \
      . /vault/secrets/$cfg; \
    fi; \
  done; \
  exec npm run start\
"]
