FROM docker.io/library/node:26.13.1

RUN apt-get update && apt-get install -y bash

WORKDIR /next

COPY package.json package-lock.json ./

RUN npm ci

ARG ZEVA2_VERSION
ENV ZEVA2_VERSION=$ZEVA2_VERSION

COPY . .

RUN npm run generate-prisma-client && npm run generate-old-prisma-client
RUN npm run build

RUN mkdir -p /tmp/.npm \
  && chgrp -R 0 /next/.next /tmp/.npm \
  && chmod -R g=u /next/.next \
  && chmod 770 /tmp/.npm \
  && chmod 1777 /tmp

ENV HOME=/tmp \
    NPM_CONFIG_CACHE=/tmp/.npm

USER 1001:0

EXPOSE 3000

CMD ["/bin/sh", "-c", "\
  for cfg in database s3 redis cthub auth; do \
    if [ -f /vault/secrets/$cfg ]; then \
      . /vault/secrets/$cfg; \
    fi; \
  done; \
  exec npm run start\
"]
